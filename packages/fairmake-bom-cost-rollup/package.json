{
  "name": "fairmake-bom-cost-rollup",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairmake-bom-cost-rollup",
  "description": "Fairmake BOM Cost Rollup: every assembly's cost rebuilt from its bill of materials and latest purchase prices, against its standard cost, with missing and stale prices and BOM loops. Loads nothing.",
