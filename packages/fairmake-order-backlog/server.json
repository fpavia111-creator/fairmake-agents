{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/fairmake-order-backlog",
  "title": "Fairmake Order Backlog",
  "description": "Fairmake Order Backlog: open customer order lines past due, due soon, never promised, promised…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairmake-agents",
    "source": "github",
    "subfolder": "packages/fairmake-order-backlog"
  },
  "websiteUrl": "https://fair-agents.com/fairmake.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fairmake-order-backlog",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
