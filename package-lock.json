{
  "name": "fairmake-agents",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fairmake-agents",
      "license": "MIT",
      "workspaces": [
        "packages/fairmake-core",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/fairmake-core": {
      "resolved": "packages/fairmake-core",
      "link": true
    },
    "node_modules/fairmake-cost-variance": {
      "resolved": "packages/fairmake-cost-variance",
      "link": true
    },
    "packages/fairmake-core": {
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "fairmake-approve": "bin/fairmake-approve.js",
        "fairmake-license": "bin/fairmake-license.js",
        "fairmake-new-agent": "bin/fairmake-new-agent.js",
        "fairmake-verify-log": "bin/fairmake-verify-log.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/fairmake-cost-variance": {
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "fairmake-core": "^0.1.0"
      },
      "bin": {
        "fairmake-cost-variance": "bin/fairmake-cost-variance.js"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
